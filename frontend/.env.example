# Frontend Environment Configuration
# Copy this file to .env.local and update values for your environment

# API Configuration
# Backend API URL - Update this to match your backend server
VITE_API_URL=http://localhost:5000/api

# Note: In the current implementation, the API URL is set in authService.js
# You can also use environment variables like this:
# const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000/api';

# Frontend URL (for redirects if needed)
VITE_FRONTEND_URL=http://localhost:3000

# Enable detailed logging (true or false)
VITE_DEBUG=false

# ============================================
# Environment-Specific Configurations
# ============================================

# Development
# VITE_API_URL=http://localhost:5000/api
# VITE_DEBUG=true

# Production
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_DEBUG=false

# Staging
# VITE_API_URL=https://api-staging.yourdomain.com/api
# VITE_DEBUG=true
